{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": [
      "chrome",
      "node"
    ]
  },
  "include": [
    "src/browser/**/*",
    "src/env.d.ts",
    "test/browser/**/*.ts",
    "test/helpers/**/*.ts",
    "test/browser-e2e/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-browser",
    "dist-browser-test",
    "dist-browser-notices"
  ]
}
